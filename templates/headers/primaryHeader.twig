{# Registering the asset files to be used in head #}
{{ craft.app.view.registerCssFile('@web/assets/css/components/' ~ block.type.handle ~ '.css') }}


{# Setting the variables #}
{% set title = block.title %}
{% set description = block.description %}
{% set image = block.headerImage %}
{% set button = block.button %}
{% set placement = block.headingSelect %}

{% set headingLevel = "h2" %}

{% if loop.index == 1 %}
    {% set headingLevel = "h1" %}
{% endif %}

<header class="c-header">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col col-lg-10 col-xl-8">
                <div class="c-header-content">
                    {% if title is not empty %}
                        {% tag headingLevel %}
                            {{ title }}{% endtag %}
                    {% endif %}
                    {% if description is not empty %}
                        <p>{{ description }}</p>
                    {% endif %}
                    {% if button is not empty %}
                        {% include '/components/partials/_button.twig' with {
                            buttonLabel: button.label,
                            buttonTarget: button.target,
                            buttonLink: button.value
                        } only %}
                    {% endif %}
                </div>
                {{ svg('@webroot/assets/images/target-icon.svg')|attr({ class: 'c-header-icon c-header-icon--target'}) }}
                {{ svg('@webroot/assets/images/bean-icon.svg')|attr({ class: 'c-header-icon c-header-icon--bean'}) }}
                {{ svg('@webroot/assets/images/donut-icon.svg')|attr({ class: 'c-header-icon c-header-icon--donut'}) }}
                {{ svg('@webroot/assets/images/scribble-icon.svg')|attr({ class: 'c-header-icon c-header-icon--scribble'}) }}
            </div>
        </div>
    </div>
</header>