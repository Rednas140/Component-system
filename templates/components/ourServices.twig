{# Registering the asset files to be used in head #}
{{ craft.app.view.registerCssFile('@web/assets/css/components/' ~ block.type.handle ~ '.css') }}

{# Setting the variables #}
{% set title = block.title %}
{% set services = block.services %}

<section class="c-ourServices">
    <div class="container">
        <div class="c-ourServices-heading">
            {% if title is not empty %}
                <h2>{{ title }}</h2>
            {% endif %}
        </div>
        <div class="c-ourServices-grid">
            {% for service in services %}
                <a href="{{ service.url }}" class="c-ourServices-item">
                    <h3>{{ service.title }}</h3>
                    {% if service.description is not empty %}
                        <p>{{ service.description }}</p>
                    {% endif %}
                </a>
            {% endfor %}
        </div>
    </div>
</section>